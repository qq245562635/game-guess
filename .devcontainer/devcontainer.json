{
  "name": "GameGuess",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/game-guess",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "GameGuess", "onAutoForward": "openBrowser" }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postAttachCommand": "npm run dev",
  "customizations": {
    "vscode": {
      "extensions": ["Prisma.prisma", "bradlc.vscode-tailwindcss", "dbaeumer.vscode-eslint"]
    }
  }
}
