# PostgreSQL connection string used by Prisma (server only).
DATABASE_URL="postgresql://gg:gg@localhost:5433/gameguess"

# Only needed for `npm run db:check` (verifies migrations match the schema).
SHADOW_DATABASE_URL="postgresql://gg:gg@localhost:5433/gameguess_shadow"

# Secret used to sign the anonymous device cookie. 32+ random characters.
# `npm run setup` fills this in automatically. To generate one by hand:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""
