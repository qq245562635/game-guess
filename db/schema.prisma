generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TermKind {
  GENRE
  PLATFORM
  PERSPECTIVE
}

enum GameStatus {
  ACTIVE
  INACTIVE
}

enum PuzzleStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  WITHDRAWN
  RESERVE
}

enum Outcome {
  IN_PROGRESS
  WON
  LOST
}

model Company {
  id        String @id @default(uuid())
  slug      String @unique
  name      String
  developed Game[] @relation("developer")
  published Game[] @relation("publisher")
}

/// Controlled vocabulary: genres, platforms, perspectives.
model Term {
  id    String     @id @default(uuid())
  kind  TermKind
  slug  String
  label String
  games GameTerm[]

  @@unique([kind, slug])
}

model Game {
  id             String     @id @default(uuid())
  slug           String     @unique
  title          String     @unique
  normTitle      String     @unique
  releaseYear    Int
  developerId    String
  publisherId    String
  developer      Company    @relation("developer", fields: [developerId], references: [id])
  publisher      Company    @relation("publisher", fields: [publisherId], references: [id])
  /// Meets the popularity threshold to be used as an answer.
  answerEligible Boolean    @default(false)
  status         GameStatus @default(ACTIVE)
  aliases        Alias[]
  terms          GameTerm[]
  puzzles        Puzzle[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model Alias {
  id     String @id @default(uuid())
  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  alias  String
  norm   String @unique
}

model GameTerm {
  gameId String
  termId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  term   Term   @relation(fields: [termId], references: [id])

  @@id([gameId, termId])
}

model Puzzle {
  id           String         @id @default(uuid())
  number       Int?           @unique
  dateUtc      DateTime?      @unique @db.Date
  answerGameId String
  answerGame   Game           @relation(fields: [answerGameId], references: [id])
  hint1        String
  hint2        String
  status       PuzzleStatus   @default(DRAFT)
  revision     Int            @default(1)
  voided       Boolean        @default(false)
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     GuessSession[]
}

model GuessSession {
  id          String    @id @default(uuid())
  deviceId    String
  puzzleId    String
  puzzle      Puzzle    @relation(fields: [puzzleId], references: [id], onDelete: Cascade)
  isArchive   Boolean   @default(false)
  outcome     Outcome   @default(IN_PROGRESS)
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  guesses     Guess[]

  @@unique([deviceId, puzzleId])
}

model Guess {
  id            String       @id @default(uuid())
  sessionId     String
  session       GuessSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  attemptNo     Int
  gameId        String
  clientGuessId String
  /// Stored GuessRow so restored games render exactly as first shown.
  feedback      Json
  createdAt     DateTime     @default(now())

  @@unique([sessionId, attemptNo])
  @@unique([sessionId, gameId])
  @@unique([sessionId, clientGuessId])
}

/// Append-only audit trail for content changes.
model ContentAudit {
  id       String   @id @default(uuid())
  entity   String
  entityId String
  action   String
  before   Json?
  after    Json?
  actor    String
  at       DateTime @default(now())
}

model Event {
  eventId  String   @id
  name     String
  props    Json
  deviceId String?
  at       DateTime @default(now())
}
